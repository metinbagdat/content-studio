{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./*"],
      "@content-studio/db": ["./packages/db/src/index.ts"]
    }
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts", "apps/worker/**/*.ts", "packages/db/src/**/*.ts"],
  "exclude": ["node_modules", "legacy", "apps/web"]
}
