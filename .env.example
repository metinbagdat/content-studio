# Content Studio - copy to .env.local for Next, .env for Prisma/worker

# --- Primary for daily `npm run dev`: local Docker (zero Supabase egress) ---
# npm run dev / npm run worker starts postgres via docker compose (predev)
DATABASE_URL="postgresql://content:content@localhost:5434/content_studio?schema=public"
PRISMA_CONNECTION_LIMIT="5"

# --- Prod / OAuth-share only: Supabase session pooler (Hobby 5GB egress/month) ---
# Do NOT point local npm run dev + worker at this URL for hours — it is billed egress.
# Dashboard: Project Settings -> Database -> Connection string -> Session mode, port 5432
# DATABASE_URL="postgresql://postgres.miihrqlqclyyvmkgkokc:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Redis optional; empty string uses DB job poll fallback (works with Supabase-only setup)
REDIS_URL=""
# REDIS_URL="redis://localhost:6380"

# Admin gate (simple shared secret for MVP) — paste this into /admin "Admin API key"
ADMIN_API_KEY="admin123"

# Vercel Cron (senaryo A — worker yok): rastgele uzun secret; Vercel otomatik Authorization header gönderir
# CRON_SECRET=""

# Phase 0 discovery (worker cron 06:00 IST + /admin/discovery)
DISCOVERY_CRON_ENABLED="true"
DISCOVERY_DAILY_LIMIT="3"
# DISCOVERY_RUN_ON_START="false"

# CS-08: stats refresh — «Günlük bakım» veya Vercel cron (worker opsiyonel)
ANALYTICS_SYNC_ENABLED="true"
ANALYTICS_SYNC_INTERVAL_MINUTES="180"
# ANALYTICS_RUN_ON_START="false"

# Brand CTA
BRAND_URL="https://egitim.today"
BRAND_NAME="egitim.today"

# WordPress SEO hub (wp-seo-hub) — draft only; see docs/WORDPRESS_BRIDGE.md
# WP_BASE_URL="https://blog.egitim.today"
# CONNECT_STUDIO_API_KEY=""
# WP_USERNAME=""
# WP_APP_PASSWORD=""
# SAFE_SAMURAI_ENABLED="true"

# Hostinger Reach (blog newsletter contacts — not LearnCon transactional mail)
# HOSTINGER_API_TOKEN=""
# HOSTINGER_REACH_PROFILE_UUID=""

# Default image fallback when auto-generation fails
POST_DEFAULT_IMAGE="https://www.egitim.today/opengraph-image.png"
# BRAND_OG_IMAGE=""

# Hands-off SM: onay → görsel → otomatik zamanlama → worker yayınlar (varsayılan: açık)
SOCIAL_AUTOPILOT="true"
# Anında yayın (autopilot zamanlamayı atlar) — dikkatli kullan
SOCIAL_AUTO_PUBLISH="false"

# LLM — Groq öncelikli (varsayılan)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Fallback: OpenAI (GROQ_API_KEY yoksa)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# Eski uyumluluk: OPENAI_API_KEY=gsk_... + OPENAI_BASE_URL=https://api.groq.com/openai/v1 de Groq sayılır

# OAuth - X (Twitter)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_CALLBACK_URL="http://localhost:3100/api/social/callback/twitter"

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:3100/api/social/callback/linkedin"
# Şirket sayfasına post için (LinkedIn Page Admin → About → Page ID)
LINKEDIN_ORGANIZATION_ID=""
# true yaparsanız LinkedIn'i "Kes" edip tekrar "OAuth bağla" ile bağlayın
# (yeni w_organization_social izni ancak yeniden OAuth ile eklenir)
LINKEDIN_ORG_POST="false"

# --- Meta (Facebook + Instagram) ---
# META_APP_ID="1309132857965857"
# META_APP_SECRET=""
# META_PAGE_ID="1153725161168373"   # Egitim.today sayfası — publish OAuth fallback için
# META_LOGIN_CONFIG_ID="1527817658530867"   # pages_show_list (ilk bağlantı)
# META_LOGIN_CONFIG_ID_PUBLISH="919581157862599"   # pages_manage_posts (yayın OAuth)
# META_LOGIN_CONFIG_ID_ENGAGEMENT="1056772926831225"   # pages_read_engagement (opsiyonel)
# META_OAUTH_PUBLISH="true"   # true iken OAuth pages_manage_posts config kullanır
# META_BULK_PUBLISH_LIMIT="8"  # Facebook/IG spam koruması (max 20)
# META_BULK_PUBLISH_GAP_MS="2500"
# META_OAUTH_SCOPES=""         # opsiyonel — tüm scope listesini override eder
# FACEBOOK_CALLBACK_URL="http://localhost:3100/api/social/callback/facebook"
# INSTAGRAM_CALLBACK_URL="http://localhost:3100/api/social/callback/instagram"
# Development modda localhost redirect otomatik izinlidir — Valid OAuth URIs boş kalabilir

# YOUTUBE_CLIENT_ID=""       # Google Cloud OAuth (YouTube Data API v3)
# YOUTUBE_CLIENT_SECRET=""
# YOUTUBE_CALLBACK_URL="http://localhost:3100/api/social/callback/youtube"
# TIKTOK_CLIENT_KEY=""       # TikTok for Developers → App → Client key
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_CALLBACK_URL="http://localhost:3100/api/social/callback/tiktok"
# Onaysız: video.upload (TikTok inbox). Onaylı: TIKTOK_AUDITED=true + video.publish
# TIKTOK_AUDITED="false"
# TIKTOK_PRIVACY_LEVEL="PUBLIC_TO_EVERYONE"
# TIKTOK_OAUTH_SCOPES="user.info.basic,video.upload"

# Token encryption (32+ chars). Required in production.
TOKEN_ENCRYPTION_KEY="dev-only-change-me-32chars-min!!"

# Auto-publish default is always false in code; do not enable casually
ALLOW_AUTO_PUBLISH="false"

# Local: http://localhost:3100 — Prod: https://studio.egitim.today
# Prod: https://studio.egitim.today — callback'ler otomatik türetilir (veya *_CALLBACK_URL override)
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Local ↔ prod VERİ senkronu: aynı Supabase DATABASE_URL kullanın (workflow, taslak, yayın paylaşılır)
# Fingerprint doğrulama (opsiyonel — npm run env:parity ile üretin, Vercel + .env.local'e yapıştırın):
# DEPLOY_PARITY_DB_FINGERPRINT=""

# TTS (Faz 2a podcast) — varsayılan: Edge TTS (ücretsiz, ek API key yok)
TTS_PROVIDER="edge"
TTS_EDGE_VOICE="tr-TR-EmelNeural"
# OpenAI TTS (TTS_PROVIDER=openai + gerçek OpenAI key, Groq URL değil):
# TTS_PROVIDER="openai"
# TTS_MODEL="tts-1"
# TTS_VOICE="nova"

# WordPress SEO hub (wp-seo-hub) — draft only; docs/WORDPRESS_BRIDGE.md
# WP_BASE_URL="https://blog.egitim.today"
# CONNECT_STUDIO_API_KEY=""
# WP_USERNAME=""
# WP_APP_PASSWORD=""
# SAFE_SAMURAI_ENABLED="true"
# HPV_GATE_ENABLED="true"
# HPV_CRON_ENABLED="true"
# HPV_DAILY_LIMIT="8"
# SEO_API_KEY=""
# SEO_API_BASE_URL=""

# Hostinger Reach — docs/HOSTINGER_REACH.md
# HOSTINGER_API_TOKEN=""
# HOSTINGER_REACH_PROFILE_UUID=""
