{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "egitim.today content auto-production & social distribution (monorepo root; separate from LearnCon)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-local.ts",
    "predev": "tsx scripts/ensure-local-docker.ts",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 && tsx scripts/ensure-local-docker.ts && npm run dev -w @content-studio/web",
    "kill-port": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1",
    "build": "prisma generate && npm run build -w @content-studio/web",
    "start": "npm run start -w @content-studio/web",
    "lint": "npm run lint -w @content-studio/web",
    "typecheck": "npm run typecheck -w @content-studio/web && npm run typecheck -w @content-studio/worker",
    "db:up": "tsx scripts/ensure-local-docker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:exec": "powershell -ExecutionPolicy Bypass -File scripts/db-execute.ps1",
    "db:studio": "prisma studio",
    "worker": "npm run drain -w @content-studio/worker",
    "preworker": "tsx scripts/ensure-local-docker.ts",
    "worker:loop": "npm run loop -w @content-studio/worker",
    "discovery:scan": "tsx --env-file=.env scripts/run-content-discovery.ts",
    "pipeline:zaman": "tsx --env-file=.env scripts/run-zaman-pipeline.ts",
    "env:parity": "tsx --env-file=.env scripts/print-db-fingerprint.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.34.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.6.1",
    "msedge-tts": "^2.0.7",
    "next": "15.5.22",
    "openai": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
