{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "egitim.today content auto-production & social distribution (monorepo root; separate from LearnCon)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 && next dev --port 3100",
    "kill-port": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "worker": "tsx --env-file=.env workers/index.ts",
    "discovery:scan": "tsx --env-file=.env scripts/run-content-discovery.ts",
    "pipeline:zaman": "tsx --env-file=.env scripts/run-zaman-pipeline.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.34.0",
    "edge-tts": "^1.0.1",
    "ioredis": "^5.6.1",
    "next": "^15.5.22",
    "openai": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
